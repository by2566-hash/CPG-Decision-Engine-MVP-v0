# ==========================================
# CPG Decision Engine MVP - Environment config
# ==========================================

# 1. Runner API Security
# Set DISABLE_SECURITY=true for local dev without headers, false for prod
DISABLE_SECURITY=false
RUNNER_API_KEY=dev_mvp_key_001

# 2. n8n Application Credentials
N8N_USER=admin
N8N_PASSWORD=admin123
N8N_WEBHOOK_URL=http://localhost:5678/

# 3. PostgreSQL Database (n8n backend)
POSTGRES_USER=n8n_user
POSTGRES_PASSWORD=n8n_pass_dev
POSTGRES_DB=n8n_db
